
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Glow Me Cosmetics</title>

<style>
*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;font-family:Arial;background:#fff7fa;color:#49313c}
header{background:white;padding:18px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;position:sticky;top:0;z-index:10;box-shadow:0 3px 15px #0001}
header h1{color:#d93670;margin:0}
nav{display:flex;flex-wrap:wrap;gap:13px}
nav a{color:#74354e;text-decoration:none;font-size:14px;font-weight:bold}
nav a:hover{color:#e52e70}
button{background:#d93670;color:white;border:0;padding:11px 17px;border-radius:25px;cursor:pointer;font-weight:bold}
button:hover{background:#a91f53}
section{padding:40px 5%}
.title{text-align:center;color:#b72e60;font-size:28px}
.hero{text-align:center;padding:85px 20px;background:linear-gradient(120deg,#f6c7d8,#fff0f5,#f5dce7)}
.hero h2{font-size:43px;color:#9e2853}
.hero p{font-size:18px;line-height:1.7}
.brands-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:18px;margin-top:25px}
.brand-card{background:white;text-align:center;padding:23px 10px;border-radius:16px;border:1px solid #f3d5df;box-shadow:0 4px 15px #0001;cursor:pointer;transition:.3s}
.brand-card:hover{transform:translateY(-5px);background:#ffeaf1}
.brand-icon{font-size:35px}
.brand-card h3{color:#bd3265;font-size:16px}
.brand-card p{color:#777;font-size:13px}
.search{display:block;width:min(500px,100%);padding:14px 20px;margin:22px auto;border:1px solid #edc1d0;border-radius:30px;font-size:15px}
.filters{text-align:center;margin:20px}
.filters button{margin:5px;background:#f5dce5;color:#9e2853}
.filters button.active{background:#d93670;color:white}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(205px,1fr));gap:20px}
.product{background:white;border-radius:16px;padding:13px;text-align:center;box-shadow:0 5px 18px #0001;border:1px solid #f8e5ec;transition:.3s}
.product:hover{transform:translateY(-5px)}
.product img{width:100%;height:185px;object-fit:cover;border-radius:12px}
.product h3{color:#71334d}
.price{color:#d93670;font-size:21px;font-weight:bold}
.product button{margin:4px}
.heart{background:#fce6ee;color:#c52b60}
.heart.selected{background:#d93670;color:white}
.panel{background:white;padding:22px;border-radius:16px;margin:20px auto;max-width:900px;box-shadow:0 4px 18px #0001}
.cart-item,.admin-product{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;border-bottom:1px solid #f3dce5;padding:13px 0}
.about,.contact{text-align:center;line-height:2}
footer{background:#782b4c;color:white;text-align:center;padding:30px;margin-top:30px}
input,select{width:100%;padding:13px;margin:7px 0;border:1px solid #edc1d0;border-radius:9px;font-size:15px;background:white}
.admin-form{display:grid;gap:8px}
.admin-form button{width:fit-content}
.admin-tools{display:flex;gap:10px;flex-wrap:wrap}
.admin-tools button{margin:5px 0}
.small-btn{padding:8px 13px;font-size:12px}
.delete-btn{background:#9b344e}
.edit-btn{background:#806080}
.modal{display:none;position:fixed;inset:0;background:#0009;justify-content:center;align-items:center;z-index:20;padding:15px}
.modal-box{background:#fff8fa;padding:28px;border-radius:18px;width:100%;max-width:380px;text-align:center}
.modal-box h2{color:#c52b60}
.close{float:right;background:#888}
.muted{color:#777;font-size:13px}
#adminMessage{color:#16834d;font-weight:bold}
@media(max-width:600px){
 header{justify-content:center;text-align:center}
 nav{justify-content:center}
 .hero{padding:55px 15px}
 .hero h2{font-size:30px}
 section{padding:30px 15px}
 .products{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}
 .product{padding:8px}
 .product img{height:135px}
 .product button{padding:8px;font-size:11px}
}
</style>
</head>

<body>

<header>
<h1>💗 Glow Me</h1>
<nav>
<a href="#home">Home</a>
<a href="#brands">Brands</a>
<a href="#shop">Shop</a>
<a href="#about">About</a>
<a href="#contact">Contact</a>
<a href="#cart">Cart (<span id="cartCount">0</span>)</a>
<a href="#wishlist">Wishlist (<span id="wishCount">0</span>)</a>
<a href="#admin">Admin</a>
<a href="#" onclick="openLogin();return false">Login</a>
</nav>
</header>

<!-- HOME -->
<div class="hero" id="home">
<h2>Beauty Begins With You ✨</h2>
<p>Discover your beauty with Glow Me Cosmetics.<br>
Explore your favourite brands in one place.</p>
<button onclick="location.href='#brands'">Explore Brands</button>
</div>

<!-- BRANDS -->
<section id="brands">
<h2 class="title">Shop By Brands 💗</h2>
<p style="text-align:center">Choose your favourite beauty brand</p>
<div class="brands-grid" id="brandList"></div>
</section>

<!-- SHOP -->
<section id="shop">
<h2 class="title">Our Beauty Collection 💄</h2>
<h3 id="brandHeading" style="text-align:center;color:#d93670">All Beauty Products</h3>

<input class="search" id="search"
placeholder="Search products or brands..."
oninput="showProducts()">

<div class="filters">
<button class="active" onclick="setCategory('All',this)">All</button>
<button onclick="setCategory('Makeup',this)">Makeup</button>
<button onclick="setCategory('Skincare',this)">Skincare</button>
<button onclick="setCategory('Haircare',this)">Haircare</button>
</div>

<div class="products" id="products"></div>
</section>

<!-- CART -->
<section id="cart">
<h2 class="title">🛒 My Shopping Cart</h2>
<div class="panel">
<div id="cartItems">Your cart is empty.</div>
<h3 id="total">Total: ₹0</h3>
<button onclick="checkout()">Proceed to Checkout</button>
</div>
</section>

<!-- WISHLIST -->
<section id="wishlist">
<h2 class="title">♡ My Wishlist</h2>
<div class="products" id="wishlistItems"></div>
</section>

<!-- ABOUT -->
<section id="about">
<h2 class="title">About Glow Me</h2>
<div class="panel about">
<h3>Welcome to Glow Me Cosmetics!</h3>
<p>Glow Me is your beauty destination for makeup,
skincare and haircare products.</p>
<p>Discover your glow. Love your beauty. 💗</p>
</div>
</section>

<!-- CONTACT -->
<section id="contact">
<h2 class="title">Contact Us</h2>
<div class="panel contact">
<p>Email: glowmecosmetics@gmail.com</p>
<p>Customer Support: Monday - Saturday</p>
</div>
</section>

<!-- ADMIN PANEL -->
<section id="admin">
<h2 class="title">⚙️ Admin Dashboard</h2>

<div class="panel">
<h3>➕ Add New Brand</h3>
<form id="brandForm" class="admin-form">
<input id="brandName" placeholder="Enter brand name" required>
<button type="submit">Add Brand</button>
</form>
</div>

<div class="panel">
<h3>➕ Add / Edit Product</h3>

<form id="productForm" class="admin-form">

<input type="hidden" id="editId">

<label>Brand Name</label>
<input id="newBrand" list="brandOptions"
placeholder="Enter or select brand" required>
<datalist id="brandOptions"></datalist>

<label>Product Name</label>
<input id="newName" placeholder="Product name" required>

<label>Product Price (₹)</label>
<input id="newPrice" type="number" min="1"
placeholder="Enter price" required>

<label>Product Category</label>
<select id="newCategory" required>
<option value="">Select Category</option>
<option value="Makeup">Makeup</option>
<option value="Skincare">Skincare</option>
<option value="Haircare">Haircare</option>
</select>

<label>Product Image URL</label>
<input id="newImage" type="url"
placeholder="Paste image URL (optional)">

<div class="admin-tools">
<button type="submit" id="saveProductBtn">Add Product</button>
<button type="button" id="cancelEditBtn"
class="edit-btn" style="display:none"
onclick="cancelEdit()">Cancel Edit</button>
</div>

<p id="adminMessage"></p>
</form>
</div>

<div class="panel">
<h3>📦 Manage Products</h3>
<p class="muted">Edit or delete products from your store.</p>
<div id="adminProducts"></div>
</div>
</section>

<footer>
<h2>💗 Glow Me Cosmetics</h2>
<p>Beauty | Confidence | Happiness</p>
<p>© 2026 Glow Me. All Rights Reserved.</p>
</footer>

<!-- LOGIN POPUP -->
<div class="modal" id="loginModal">
<div class="modal-box">
<button class="close" onclick="closeLogin()">X</button>
<h2 id="formTitle">Welcome Back 💗</h2>
<form id="loginForm">
<input id="userName" placeholder="Your Name" style="display:none">
<input id="userEmail" type="email" placeholder="Email Address" required>
<input id="userPassword" type="password" placeholder="Password" required>
<button type="submit" id="submitBtn">Login</button>
</form>
<p id="loginMessage"></p>
<p id="switchText">
New user? <a href="#" onclick="switchForm();return false">Sign Up</a>
</p>
</div>
</div>

<script>

/* DEFAULT PRODUCTS */

const defaultProducts = [
{id:1,brand:"Maybelline",name:"Fit Me Foundation",price:499,category:"Makeup",emoji:"💄",image:"https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=500"},
{id:2,brand:"Maybelline",name:"Matte Lipstick",price:399,category:"Makeup",emoji:"💋",image:"https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=500"},
{id:3,brand:"Lakme",name:"Face Cream",price:350,category:"Skincare",emoji:"🧴",image:"https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=500"},
{id:4,brand:"Lakme",name:"Makeup Kit",price:799,category:"Makeup",emoji:"💄",image:"https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=500"},
{id:5,brand:"L'Oreal Paris",name:"Hair Serum",price:599,category:"Haircare",emoji:"✨",image:"https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?w=500"},
{id:6,brand:"L'Oreal Paris",name:"Skin Cream",price:499,category:"Skincare",emoji:"🧴",image:"https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?w=500"},
{id:7,brand:"Mamaearth",name:"Vitamin C Face Wash",price:249,category:"Skincare",emoji:"🌸",image:"https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?w=500"},
{id:8,brand:"Mamaearth",name:"Hair Shampoo",price:349,category:"Haircare",emoji:"🧴",image:"https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=500"},
{id:9,brand:"Sugar Cosmetics",name:"Sugar Lipstick",price:499,category:"Makeup",emoji:"💋",image:"https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=500"},
{id:10,brand:"Sugar Cosmetics",name:"Makeup Palette",price:699,category:"Makeup",emoji:"🎨",image:"https://images.unsplash.com/photo-1512496015851-a90fb38ba796?w=500"},
{id:11,brand:"Nivea",name:"Soft Cream",price:199,category:"Skincare",emoji:"🧴",image:"https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=500"},
{id:12,brand:"Nivea",name:"Body Lotion",price:299,category:"Skincare",emoji:"🌸",image:"https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?w=500"}
];

/* LOAD SAVED DATA */

function loadData(key,fallback) {
  try {
    let data = localStorage.getItem(key);
    return data === null ? fallback : JSON.parse(data);
  } catch(e) {
    return fallback;
  }
}

let products = loadData("glowProducts",defaultProducts);
let brandNames = loadData("glowBrands",
  ["Maybelline","Lakme","L'Oreal Paris","Mamaearth","Sugar Cosmetics","Nivea"]);

let cart = loadData("glowCart",[]);
let wishlist = loadData("glowWish",[]);
let category = "All";
let selectedBrand = "All";
let signup = false;

function saveProducts() {
  localStorage.setItem("glowProducts",JSON.stringify(products));
  localStorage.setItem("glowBrands",JSON.stringify(brandNames));
}

function saveData() {
  localStorage.setItem("glowCart",JSON.stringify(cart));
  localStorage.setItem("glowWish",JSON.stringify(wishlist));
}

function safe(value) {
  return String(value).replace(/[&<>"']/g,c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",
    '"':"&quot;","'":"&#39;"
  }[c]));
}

function safeImage(url) {
  try {
    let u = new URL(url);
    return ["http:","https:"].includes(u.protocol) ? u.href : "";
  } catch(e) {
    return "";
  }
}

/* BRAND DISPLAY */

function showBrands() {
  let brands = [...new Set([...brandNames,...products.map(p=>p.brand)])];

  let list = [
    {name:"All",icon:"💗"},
    ...brands.map((name,i)=>({
      name:name,
      icon:["💄","🌸","✨","🌿","💋","🧴","💅"][i%7]
    }))
  ];

  document.getElementById("brandList").innerHTML = list.map(b=>{
    let count = b.name === "All" ? products.length :
      products.filter(p=>p.brand.toLowerCase()===b.name.toLowerCase()).length;

    return `
      <div class="brand-card" data-brand="${safe(b.name)}">
        <div class="brand-icon">${b.icon}</div>
        <h3>${safe(b.name==="All"?"All Brands":b.name)}</h3>
        <p>${count} Products</p>
        <button type="button">View Products</button>
      </div>`;
  }).join("");

  document.querySelectorAll(".brand-card").forEach(card=>{
    card.addEventListener("click",()=>{
      selectBrand(card.dataset.brand);
    });
  });

  document.getElementById("brandOptions").innerHTML =
    brands.map(b=>`<option value="${safe(b)}"></option>`).join("");
}

/* SELECT BRAND */

function selectBrand(brand) {
  selectedBrand = brand;
  category = "All";
  document.getElementById("search").value = "";

  document.querySelectorAll(".filters button")
    .forEach(b=>b.classList.remove("active"));
  document.querySelector(".filters button").classList.add("active");

  document.getElementById("brandHeading").innerText =
    brand==="All" ? "All Beauty Products" : brand+" Products";

  showProducts();
  document.getElementById("shop").scrollIntoView();
}

/* SHOW PRODUCTS */

function showProducts() {
  let search = document.getElementById("search").value.toLowerCase();

  let list = products.filter(p=>
    (selectedBrand==="All" || p.brand.toLowerCase()===selectedBrand.toLowerCase()) &&
    (category==="All" || p.category===category) &&
    (p.name.toLowerCase().includes(search) ||
     p.brand.toLowerCase().includes(search))
  );

  document.getElementById("products").innerHTML =
    list.length ? list.map(p=>`
      <div class="product">
        <img src="${safe(safeImage(p.image))}" alt="${safe(p.name)}"
          onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
        <div style="display:none;font-size:65px;padding:30px">${p.emoji||"💗"}</div>
        <h3>${safe(p.name)}</h3>
        <p>${safe(p.brand)}</p>
        <p>${safe(p.category)}</p>
        <p class="price">₹${Number(p.price)}</p>
        <button onclick="addCart(${Number(p.id)})">Add to Cart</button>
        <button class="heart ${wishlist.includes(p.id)?"selected":""}"
          onclick="toggleWish(${Number(p.id)})">♡ Wishlist</button>
      </div>
    `).join("") : "<p>No products found.</p>";
}

/* CATEGORY FILTER */

function setCategory(value,btn) {
  category = value;
  document.querySelectorAll(".filters button")
    .forEach(b=>b.classList.remove("active"));
  btn.classList.add("active");
  showProducts();
}

/* ADD BRAND */

document.getElementById("brandForm").addEventListener("submit",function(e) {
  e.preventDefault();

  let name = document.getElementById("brandName").value.trim();

  if(brandNames.some(b=>b.toLowerCase()===name.toLowerCase())) {
    alert("This brand already exists!");
    return;
  }

  brandNames.push(name);
  saveProducts();
  showBrands();
  this.reset();
  alert("New brand added successfully! 💗");
});

/* ADD OR EDIT PRODUCT */

document.getElementById("productForm").addEventListener("submit",function(e) {
  e.preventDefault();

  let id = document.getElementById("editId").value;
  let brand = document.getElementById("newBrand").value.trim();
  let name = document.getElementById("newName").value.trim();
  let price = Number(document.getElementById("newPrice").value);
  let cat = document.getElementById("newCategory").value;
  let image = document.getElementById("newImage").value.trim();

  if(!brand || !name || !price || price<=0 || !cat) {
    alert("Please fill all required details correctly.");
    return;
  }

  if(image && !safeImage(image)) {
    alert("Please enter a valid http or https image URL.");
    return;
  }

  if(!brandNames.some(b=>b.toLowerCase()===brand.toLowerCase())) {
    brandNames.push(brand);
  }

  if(id) {
    let index = products.findIndex(p=>p.id===Number(id));
    if(index===-1) return;

    products[index] = {
      ...products[index],
      brand,name,price,category:cat,image
    };

    document.getElementById("adminMessage").innerText =
      "Product updated successfully! 💗";
  } else {
    products.push({
      id:Date.now(),
      brand,name,price,category:cat,
      image,emoji:"💗"
    });

    document.getElementById("adminMessage").innerText =
      "New product added successfully! 💗";
  }

  saveProducts();
  this.reset();
  document.getElementById("editId").value="";
  document.getElementById("saveProductBtn").innerText="Add Product";
  document.getElementById("cancelEditBtn").style.display="none";

  showBrands();
  showProducts();
  showAdminProducts();
});

/* ADMIN PRODUCT LIST */

function showAdminProducts() {
  document.getElementById("adminProducts").innerHTML =
    products.length ? products.map(p=>`
      <div class="admin-product">
        <span>
          <b>${safe(p.name)}</b><br>
          <span class="muted">${safe(p.brand)} | ₹${Number(p.price)} | ${safe(p.category)}</span>
        </span>
        <span>
          <button class="small-btn edit-btn" onclick="editProduct(${Number(p.id)})">Edit</button>
          <button class="small-btn delete-btn" onclick="deleteProduct(${Number(p.id)})">Delete</button>
        </span>
      </div>
    `).join("") : "No products available.";
}

/* EDIT PRODUCT */

function editProduct(id) {
  let p = products.find(x=>x.id===id);
  if(!p) return;

  document.getElementById("editId").value=p.id;
  document.getElementById("newBrand").value=p.brand;
  document.getElementById("newName").value=p.name;
  document.getElementById("newPrice").value=p.price;
  document.getElementById("newCategory").value=p.category;
  document.getElementById("newImage").value=p.image||"";

  document.getElementById("saveProductBtn").innerText="Update Product";
  document.getElementById("cancelEditBtn").style.display="inline-block";
  document.getElementById("adminMessage").innerText="Editing: "+p.name;

  document.getElementById("admin").scrollIntoView();
}

/* CANCEL EDIT */

function cancelEdit() {
  document.getElementById("productForm").reset();
  document.getElementById("editId").value="";
  document.getElementById("saveProductBtn").innerText="Add Product";
  document.getElementById("cancelEditBtn").style.display="none";
  document.getElementById("adminMessage").innerText="";
}

/* DELETE PRODUCT */

function deleteProduct(id) {
  if(!confirm("Are you sure you want to delete this product?")) return;

  products = products.filter(p=>p.id!==id);
  cart = cart.filter(p=>p.id!==id);
  wishlist = wishlist.filter(x=>x!==id);

  saveProducts();
  saveData();

  if(selectedBrand!=="All" &&
     !products.some(p=>p.brand.toLowerCase()===selectedBrand.toLowerCase())) {
    selectedBrand="All";
    document.getElementById("brandHeading").innerText="All Beauty Products";
  }

  showBrands();
  showProducts();
  showAdminProducts();
  updateCart();
}

/* CART */

function addCart(id) {
  let item = cart.find(p=>p.id===id);
  if(item) item.qty++;
  else cart.push({id:id,qty:1});

  saveData();
  updateCart();
  alert("Product added to cart! 💗");
}

function changeQty(id,change) {
  let item = cart.find(p=>p.id===id);
  if(!item) return;
  item.qty+=change;
  if(item.qty<=0) cart=cart.filter(p=>p.id!==id);
  saveData();
  updateCart();
}

function removeCart(id) {
  cart=cart.filter(p=>p.id!==id);
  saveData();
  updateCart();
}

function updateCart() {
  cart=cart.filter(item=>products.some(p=>p.id===item.id));

  let total=0;
  document.getElementById("cartCount").innerText =
    cart.reduce((sum,p)=>sum+p.qty,0);

  document.getElementById("cartItems").innerHTML =
    cart.length ? cart.map(item=>{
      let p=products.find(x=>x.id===item.id);
      total+=p.price*item.qty;
      return `
        <div class="cart-item">
          <span>${safe(p.name)} (${safe(p.brand)})</span>
          <span>₹${p.price} × ${item.qty}</span>
          <span>
            <button onclick="changeQty(${p.id},-1)">−</button>
            <button onclick="changeQty(${p.id},1)">+</button>
            <button class="delete-btn" onclick="removeCart(${p.id})">Remove</button>
          </span>
        </div>`;
    }).join("") : "Your cart is empty.";

  document.getElementById("total").innerText="Total: ₹"+total;
  saveData();
  updateWishlist();
}

/* WISHLIST */

function toggleWish(id) {
  if(wishlist.includes(id)) wishlist=wishlist.filter(x=>x!==id);
  else wishlist.push(id);

  saveData();
  showProducts();
  updateWishlist();
}

function updateWishlist() {
  wishlist=wishlist.filter(id=>products.some(p=>p.id===id));
  document.getElementById("wishCount").innerText=wishlist.length;

  let items=products.filter(p=>wishlist.includes(p.id));

  document.getElementById("wishlistItems").innerHTML =
    items.length ? items.map(p=>`
      <div class="product">
        <img src="${safe(safeImage(p.image))}" alt="${safe(p.name)}"
          onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
        <div style="display:none;font-size:60px;padding:30px">💗</div>
        <h3>${safe(p.name)}</h3>
        <p>${safe(p.brand)}</p>
        <p class="price">₹${p.price}</p>
        <button onclick="addCart(${p.id})">Add to Cart</button>
        <button onclick="toggleWish(${p.id})">Remove</button>
      </div>
    `).join("") : "<p>Your wishlist is empty.</p>";

  saveData();
}

/* CHECKOUT DEMO */

function checkout() {
  if(cart.length===0) {
    alert("Your cart is empty!");
    return;
  }

  let total=cart.reduce((sum,item)=>{
    let p=products.find(x=>x.id===item.id);
    return sum+(p?p.price*item.qty:0);
  },0);

  alert("Glow Me Checkout 💗\nYour total is ₹"+total+
    "\nDemo only. No real payment has been made.");
}

/* LOGIN DEMO */

function openLogin() {
  document.getElementById("loginModal").style.display="flex";
}

function closeLogin() {
  document.getElementById("loginModal").style.display="none";
}

function switchForm() {
  signup=!signup;
  document.getElementById("formTitle").innerText=
    signup?"Create Account 💗":"Welcome Back 💗";
  document.getElementById("userName").style.display=
    signup?"block":"none";
  document.getElementById("userName").required=signup;
  document.getElementById("submitBtn").innerText=
    signup?"Sign Up":"Login";
  document.getElementById("switchText").innerHTML=
    signup
    ? 'Already registered? <a href="#" onclick="switchForm();return false">Login</a>'
    : 'New user? <a href="#" onclick="switchForm();return false">Sign Up</a>';
  document.getElementById("loginMessage").innerText="";
}

document.getElementById("loginForm").addEventListener("submit",function(e) {
  e.preventDefault();

  let email=document.getElementById("userEmail").value;
  let password=document.getElementById("userPassword").value;
  let name=document.getElementById("userName").value;
  let users=loadData("glowUsers",{});

  if(signup) {
    if(users[email]) {
      document.getElementById("loginMessage").innerText="Email already registered!";
      return;
    }
    users[email]={name,password};
    localStorage.setItem("glowUsers",JSON.stringify(users));
    alert("Account created! Please login.");
    signup=false;
    switchForm();
    document.getElementById("userPassword").value="";
    return;
  }

  if(users[email] && users[email].password===password) {
    alert("Welcome "+users[email].name+"! 💗");
    closeLogin();
  } else {
    document.getElementById("loginMessage").innerText=
      "Account not found or incorrect password. Please sign up first.";
  }
});

